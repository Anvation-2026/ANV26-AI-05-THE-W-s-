# SignalTwin API settings. Copy to .env and change what you need. Every value has a safe default.

# --- who may call the API from a browser (comma separated origins) ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# If set, every request except /v1/health must send it as the X-API-Key header.
API_KEY=

# --- limits ---
MAX_UPLOAD_MB=800
MAX_DURATION_S=2700
MAX_WIDTH=3840
RETENTION_HOURS=24
RATE_LIMIT_PER_MINUTE=240
UPLOAD_LIMIT_PER_HOUR=30
MAX_JSON_KB=4096

# --- analysis ---
WORKERS=1
QUEUE_MAX=8
JOB_TIMEOUT_FACTOR=3
JOB_TIMEOUT_MIN_S=600
JOB_MEMORY_LIMIT_MB=6000
MAX_PROC_WIDTH=1280
TARGET_FPS=10
MIN_FPS=5

# --- detector: yolo (real model), synthetic or stub (tests only) ---
DETECTOR=yolo
MODEL_WEIGHTS=models/yolo11n.pt
# Optional model that also knows auto-rickshaws. Takes precedence when set.
MODEL_WEIGHTS_5CLASS=
DEVICE=auto
CONFIDENCE=0.30
IOU=0.5

# --- storage: local (disk + SQLite) or supabase (see docs/DEPLOYMENT.md) ---
STORAGE=local
DATA_DIR=data
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=videos

LOG_LEVEL=INFO
